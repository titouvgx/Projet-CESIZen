# ============================================================
# CESIZen — Fichier de configuration d'environnement (modèle)
# ============================================================
# Copier ce fichier sous le nom .env à la racine du dépôt
# et renseigner les valeurs réelles.
#
#   cp .env.example .env
#
# Ces variables sont injectées dans le build Flutter via --dart-define.
# Elles ne sont PAS lues à l'exécution dans le navigateur.
# Elles sont compilées dans le JavaScript produit par flutter build.
#
# IMPORTANT : Ne jamais commiter le fichier .env.
#             Ce fichier .env.example est le seul à versionner.
# ============================================================


# URL du projet Supabase
# Où trouver : Supabase Dashboard → Settings → API → Project URL
# Format      : https://<ref>.supabase.co
SUPABASE_URL=https://votre-projet.supabase.co


# Clé anonyme publique (anon key)
# Où trouver : Supabase Dashboard → Settings → API → Project API keys → anon / public
# Cette clé est safe côté client : elle est soumise aux Row Level Security (RLS) policies.
# Ne jamais utiliser la service_role key côté frontend.
SUPABASE_ANON_KEY=votre-cle-anon-publique


# ============================================================
# Usage
# ============================================================
#
# Linux / Mac :
#   source .env && ./scripts/run_local.sh
#
# Windows (cmd) :
#   set SUPABASE_URL=https://... && set SUPABASE_ANON_KEY=eyJ... && scripts\run_local.bat
#
# Windows (PowerShell) :
#   $env:SUPABASE_URL="https://..."; $env:SUPABASE_ANON_KEY="eyJ..."; scripts\run_local.bat
# ============================================================
